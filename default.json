{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared dependency update policy for active Team 401 applications",
  "extends": [
    "config:recommended",
    "group:monorepos"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "configMigration": true,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 8,
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "rangeStrategy": "auto",
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 9am on the first day of the month"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ],
    "minimumReleaseAge": "0 days",
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Group routine npm updates to reduce PR volume",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "npm non-major dependencies",
      "automerge": true
    },
    {
      "description": "Group routine Rust updates in native applications",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "Cargo non-major dependencies",
      "automerge": true
    },
    {
      "description": "Keep GitHub Actions updates together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    }
  ]
}
